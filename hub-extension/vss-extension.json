{
    "manifestVersion": 1,
    "id": "smart-release-notes-dev",
    "name": "Smart Release Notes Generator (Dev)",
    "version": "1.0.9",
    "publisher": "ReleaseManagerTools",
    "description": "Génère automatiquement des Release Notes structurées et orientées client via LLM à partir des tickets fermés d'une release Azure DevOps.",
    "categories": ["Azure Pipelines"],
    "icons": {
        "default": "icon.png"
    },
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "contributions": [
        {
            "id": "release-notes-hub",
            "type": "ms.vss-web.hub",
            "targets": ["ms.vss-web.project-admin-hub-group"],
            "properties": {
                "name": "Release Notes Generator",
                "uri": "index.html"
            }
        }
    ],
    "files": [
        {"path": "index.html", "addressable": true},
        {"path": "app.js", "addressable": true},
        {"path": "style.css", "addressable": true},
        {"path": "icon.png", "addressable": true},
        {"path": "sdk/scripts/VSS.SDK.min.js", "addressable": true},
        {
            "path": "overview.md",
            "assetType": "Microsoft.VisualStudio.Services.Content.Details"
        }
    ]
}